# headless-replay environment variables
# Copy to .env and customize. .env is gitignored.

# RECORDING_ID: basename suffix of recording_<ID>.jsonl in ../sessions
# If unset, the entrypoint picks the most recently modified recording.
# Example: archer-gameplay-v1
RECORDING_ID=

# SPEED: replay speed multiplier (1.0 = realtime). Float.
SPEED=1.0

# REWRITE_HOST: host that the server rewrites server-side traffic to point at.
# Must match the server's static IP on replay-net so clients on the network
# connect back to the replay server (and not the real prod IP).
REWRITE_HOST=10.42.0.10

# SWAP_WITH_CHARACTER: optional character name to swap with during replay.
# Leave blank to disable.
SWAP_WITH_CHARACTER=

# --- wine-client service ---

# LOGIN_SLOT: character slot to pick during login phase (default: 0).
LOGIN_SLOT=0

# SKIP_LOGIN: set to any non-empty value to skip the pre-world phase
# (assumes the wine'd client is already in-world). Leave blank to login.
SKIP_LOGIN=

# INJECT_DELAY: seconds to wait after launching wine before driving clicks,
# giving DXRender + dom_replay.dll time to attach. Default: 12.
INJECT_DELAY=12

# TOKEN: 64-hex client auth token passed as XenClient.exe -ID. Default matches
# wine-replay's Makefile.
TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# WINEDEBUG: wine debug channels. Default -all keeps logs tractable; set to
# e.g. -d3d,+winediag for first-boot diagnostics.
WINEDEBUG=-all

# --- tracer service (Unicorn-based; only used with `--profile tracer`) ---

# FN_VA: VA (or RVA) of the function inside DXRender.exe to emulate.
# Default = VA_FN_MOUSE (the Delphi register-fastcall mouse handler).
FN_VA=0x000EF6D8
# SELF_PTR: value loaded into EAX (Delphi `Self`). Default in entrypoint is the
# VA of the active-widget pointer slot.
SELF_PTR=
# FLAGS: value loaded into EDX. 0x08 = down, 0x10 = up.
FLAGS=
# XY_PACKED: value loaded into ECX. (X<<16)|Y in form-local pixels. If left
# blank and RECORDING_ID is set, the entrypoint derives one from the recording.
XY_PACKED=
# BTN: pushed onto the stack at [esp+4]. 1 = LMB.
BTN=1
# TRACE_NAME: output is written to /traces/${TRACE_NAME}.jsonl
TRACE_NAME=trace
